{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "index.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.js" }],
  "crons": [
    {
      "path": "/cron/vercel/master/morning",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/cron/vercel/master/evening",
      "schedule": "0 21 * * *"
    }
  ]
}
